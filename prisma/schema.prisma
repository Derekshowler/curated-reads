// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  // NOTE: URL is supplied via prisma.config.ts (Prisma 7+), so no `url = env("DATABASE_URL")` here.
}

generator client {
  provider = "prisma-client-js"
}

enum BookListVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  handle        String?   @unique  // ✅ NEW

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  profile  Profile?
  lists     BookList[]
  follows   BookListFollow[]  // ✅ NEW
}



model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id   String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  displayName String?
  bio         String?
  vibeTags    String[] @default([])

  location       String?
  favoriteGenres String?
  websiteUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookList {
  id     String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name        String
  slug        String
  emoji       String?
  description String?

  visibility BookListVisibility @default(PRIVATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     BookListItem[]
  followers BookListFollow[]  // ✅ NEW

  @@index([userId])
  @@unique([userId, slug])
  // Optional (uncomment if you want to prevent duplicate list names per user):
  // @@unique([userId, name])
}

model BookListItem {
  id     String @id @default(cuid())

  list   BookList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId String

  bookId   String
  position Int    @default(0)

  title         String
  authors       String
  coverImageUrl String?
  publishedYear String?

  createdAt DateTime @default(now())

  @@index([listId, createdAt])
  @@unique([listId, bookId])
}

model BookListFollow {
  id        String   @id @default(cuid())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  list      BookList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId    String

  createdAt DateTime @default(now())

  @@unique([userId, listId])
  @@index([listId, createdAt])
  @@index([userId, createdAt])
}
