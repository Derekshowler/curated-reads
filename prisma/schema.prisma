generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id @default(cuid())
  email         String?          @unique
  name          String?
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  emailVerified DateTime?
  handle        String?          @unique
  accounts      Account[]
  lists         BookList[]
  follows       BookListFollow[]
  profile       Profile?
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String?
  bio            String?
  location       String?
  favoriteGenres String?
  websiteUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  vibeTags       String[] @default([])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BookList {
  id          String             @id @default(cuid())
  userId      String
  name        String
  slug        String
  emoji       String?
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  visibility  BookListVisibility @default(PRIVATE)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  followers   BookListFollow[]
  items       BookListItem[]

  @@unique([userId, slug])
  @@index([userId])
}

model BookListItem {
  id            String   @id @default(cuid())
  listId        String
  bookId        String
  position      Int      @default(0)
  title         String
  authors       String
  coverImageUrl String?
  publishedYear String?
  createdAt     DateTime @default(now())
  list          BookList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, bookId])
  @@index([listId, createdAt])
}

model BookListFollow {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())
  list      BookList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId, createdAt])
  @@index([userId, createdAt])
}

enum BookListVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}
